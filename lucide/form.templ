package lucide

templ Form(class string) {
	<svg
		class={ class }
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		@templ.Raw(`<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M4 14h6M4 2h10"/><rect width="16" height="4" x="4" y="18" rx="1"/><rect width="16" height="4" x="4" y="6" rx="1"/></g>`)
	</svg>
}

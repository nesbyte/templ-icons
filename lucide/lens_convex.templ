package lucide

templ LensConvex(class string) {
	<svg
		class={ class }
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		@templ.Raw(`<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.433 2a1 1 0 0 1 .824.448a18 18 0 0 1 0 19.104a1 1 0 0 1-.824.448h-2.866a1 1 0 0 1-.824-.448a18 18 0 0 1 0-19.104A1 1 0 0 1 10.567 2z"/>`)
	</svg>
}

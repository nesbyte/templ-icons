package lucide

templ MirrorRound(class string) {
	<svg
		class={ class }
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		@templ.Raw(`<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M10 6.6L8.6 8M12 18v4m3-14.5L9.5 13M7 22h10"/><circle cx="12" cy="10" r="8"/></g>`)
	</svg>
}

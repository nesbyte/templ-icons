package lucide

templ ZodiacGemini(class string) {
	<svg
		class={ class }
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		@templ.Raw(`<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 4.525v14.948M20 3A17 17 0 0 1 4 3m0 18a17 17 0 0 1 16 0M8 4.525v14.948"/>`)
	</svg>
}
